# nullsafe-hermes-lever — watcher configuration (copy to .env, fill in)

# Where the watcher reads each companion's chosen model key (active_model).
HALSETH_BASE=https://your-halseth.workers.dev

# Hermes config dir for the default profile (optional; defaults to ~/.hermes).
# HERMES_HOME=/home/youruser/.hermes

# Path to the hermes CLI (optional; defaults to <HERMES_HOME>/hermes-agent/venv/bin/hermes).
# HERMES_BIN=/home/youruser/.hermes/hermes-agent/venv/bin/hermes

# Path to the model map (optional; defaults to hermes-model-map.json next to the script).
# HERMES_MODEL_MAP=/home/youruser/nullsafe-hermes-lever/hermes-model-map.json

# Poll interval in seconds (optional; default 15).
# POLL_SECONDS=15

# Optional Telegram confirmation pings. Leave unset to disable.
# These can live here or in NOTIFY_ENV (defaults to <HERMES_HOME>/.env).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_HOME_CHANNEL=

# NOTE: each Hermes profile's own .env must carry a MCP_HALSETH_API_KEY that the
# watcher uses to authenticate its reads against HALSETH_BASE.
